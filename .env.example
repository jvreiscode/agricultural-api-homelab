# Copie este arquivo para .env e ajuste os valores
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=troque_esta_senha
DB_NAME=meubanco

# Nome da coluna usada como chave primária nos endpoints /{table}/{id}
DEFAULT_PK_COLUMN=id

# Opcional: se definido, a API vai exigir o header "X-API-Key" em toda requisição
API_KEY=troque-esta-chave-secreta
